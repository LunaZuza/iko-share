# ใช้ในเครื่อง (development)
REACT_APP_API_URL=http://localhost:5000/api

# เมื่อ deploy ขึ้น Vercel ให้ตั้งค่า REACT_APP_API_URL ใน Project Settings -> Environment Variables:
#   REACT_APP_API_URL = https://<ชื่อ backend ของคุณ>.onrender.com/api
# แล้ว build ใหม่ (CRA จะฝังค่านี้ไว้ใน bundle ตอน build)

# === Server ===
PORT=5000
NODE_ENV=development

# === Database ===
# ใช้ชุดนี้ถ้าเชื่อมกับ PostgreSQL ในเครื่อง
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carpool_db
DB_USER=carpool_user
DB_PASSWORD=carpool123
DB_SSL=false

# ใช้ตัวนี้แทน (สูงกว่า) ถ้ามี DATABASE_URL จาก Render / Railway / Supabase
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# === JWT ===
# เปลี่ยนเป็นข้อความสุ่มยาว ๆ ใน production
JWT_SECRET=change_me_to_a_long_random_string

# === Frontend ===
FRONTEND_URL=http://localhost:3000
